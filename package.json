{
  "name": "codemirror-lang-gawk",
  "version": "1.0.0",
  "description": "CodeMirror 6 plugin and language support for GNU AWK (gawk)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview"
  },
  "keywords": [
    "codemirror",
    "codemirror-6",
    "awk",
    "gawk",
    "gnu-awk",
    "syntax-highlighting",
    "editor"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.33.0",
    "@lezer/highlight": "^1.2.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
